{
    "cmake.useCMakePresets": "always",
    "cmake.cmakePath": "${workspaceFolder}/.pixi/envs/default/Library/bin/cmake.exe",
    "files.associations": {
        "bitset": "cpp",
        "deque": "cpp",
        "initializer_list": "cpp",
        "list": "cpp",
        "queue": "cpp",
        "stack": "cpp",
        "type_traits": "cpp",
        "valarray": "cpp",
        "vector": "cpp",
        "xhash": "cpp",
        "xstring": "cpp",
        "xtree": "cpp",
        "xutility": "cpp"
    },
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": ".*\\.(cpp|h|inl)$",
                "cmd": ".pixi\\envs\\default\\Library\\bin\\clang-format.exe ${file}"
            }
        ]
    }
}